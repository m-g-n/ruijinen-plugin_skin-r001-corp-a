<?xml version="1.0"?>
<ruleset name="ruijinen-skin-r001-corp-a">
	<description>WordPress Coding Standards for ruijinen-skin-r001-corp-a</description>

	<file>./ruijinen-skin-r001-corp-a.php</file>
	<file>./App</file>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.2"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress">
		<!-- クラスファイルは App/ 配下で PascalCase のファイル名を採用しているため除外 -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="ruijinen-skin-r001-corp-a"/>
			</property>
		</properties>
	</rule>
</ruleset>
